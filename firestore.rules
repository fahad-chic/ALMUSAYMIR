rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============ الدوال المساعدة ============
    // الجلسة الموثّقة = حساب Firebase ببريد مُوثّق (email_verified). سياسة
    // الموقع تمنع الزائر/المجهول وتُلزم التوثيق قبل فتح أي صفحة، لذا لا مسار
    // مشروع لحساب غير موثّق. بدون هذا الشرط يستطيع أي شخص إنشاء حساب عبر
    // واجهة Firebase REST العامة ثم الكتابة في المجموعات قبل التوثيق.
    function isVerified() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    // الزائر المجهول: قراءة المحتوى العام فقط، بلا صلاحيات كتابة أو مراسلة.
    function isAnonymousGuest() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // جلسة موجودة بغض النظر عن التوثيق — تُستخدم فقط حيث يجب أن تنجح كتابة
    // لحظة إنشاء الحساب (ملف المستخدم يُنشأ قبل وصول رسالة التوثيق).
    function isAuthed() {
      return request.auth != null;
    }

    // ============ وضع الصيانة (فرض فعلي للكتابة) ============
    // عند تفعيل settings/maintenance {enabled:true} تُجمَّد كل الكتابات
    // المُنشئة للمحتوى من غير المالك على مستوى الخادم — أي أن إظهار شاشة
    // الصيانة في الواجهة ليس الحماية الوحيدة. المالك يعمل دائماً (كي لا يُقفل
    // نفسه)، والقراءة تبقى متاحة حتى لا ينكسر العرض العام.
    function maintenanceOn() {
      return exists(/databases/$(database)/documents/settings/maintenance)
        && get(/databases/$(database)/documents/settings/maintenance).data.get('enabled', false) == true;
    }

    function canWriteDuringMaintenance() {
      return isOwner() || !maintenanceOn();
    }

    // ============ بوابة التسجيل (BLOCK_USER_REGISTRATION) ============
    // settings/registrationGate { blocked: bool, reason: string }. الافتراضي
    // مفتوح (الغياب أو blocked=false = التسجيل يعمل). عند blocked=true تُرفض
    // كتابة users/{uid} (العضوية) خادمياً — فيبقى الحساب بلا عضوية فعّالة
    // ولا يفتح الموقع. الحسابات القائمة (وثيقتها موجودة) تستمر بالدخول.
    // لا يمكن حجب إنشاء حساب Firebase Auth نفسه (REST عام) لكن العضوية
    // الفعّالة تُمنع هنا — فرض حقيقي لا مجرد إخفاء زر.
    function registrationBlocked() {
      return exists(/databases/$(database)/documents/settings/registrationGate)
        && get(/databases/$(database)/documents/settings/registrationGate).data.get('blocked', false) == true;
    }

    // مالك بالبريد فقط (بلا شرط التوثيق) — يُستخدم حصراً للسماح للمالك بإنشاء
    // وثيقة عضويته الخاصة حتى لو كان التسجيل مغلقاً، فلا يُقفل نفسه خارج الموقع.
    function isOwnerToken() {
      return request.auth != null
        && request.auth.token.email in [
          'f882771f@gmail.com',
          'kal6667222@gmail.com'
        ];
    }

    // ============ فرض الحظر فعلياً على مستوى الخادم ============
    // حالة الحظر تُقرأ من users/{uid} — الحقلان مدعومان لأن الواجهة تكتب
    // 'banned: true' (غرفة المالك) و 'status: "banned"' (لوحة الشكاوى/المتجر).
    // بدون هذا الفحص كان الحظر يظهر في الواجهة فقط بينما يبقى المحظور قادراً
    // على الكتابة/القراءة فعلياً عبر REST أو بكود متصفح معدّل (حماية وهمية).
    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // انتهت مدة الحظر المؤقت: حُدِّد banExpiresAt في الماضي.
    // الحظر الدائم (BAN_USER_PERMANENT) لا يحمل banExpiresAt فيبقى فعّالاً.
    // ملاحظة: Map.get في قواعد Firestore يتطلب وسيطين (المفتاح + القيمة الافتراضية).
    function isBanExpired(uid) {
      return get(userDocPath(uid)).data.keys().hasAny(['banExpiresAt'])
        && get(userDocPath(uid)).data.get('banExpiresAt', null) != null
        && get(userDocPath(uid)).data.get('banExpiresAt', null) <= request.time;
    }

    // ============ إنهاء الجلسة قسرياً (FORCE_LOGOUT_SESSION) ============
    // عند كتابة forceLogoutAt (ثواني epoch) في users/{uid} يصبح كل رمز هوية
    // صدر قبل تلك اللحظة غير صالح على مستوى القواعد (مطابقة auth_time)، وإعادة
    // تسجيل الدخول تُصدر auth_time أحدث فتُبطل المطابقة — إنهاء حقيقي خادمياً.
    // ندمج الفحصين في دالة واحدة بنفس قراءة وثيقة المستخدم (get مُخزّنة) حتى
    // لا نتجاوز سقف تعبيرات قواعد Firestore في القواعد المركّبة (haraj_ads).
    // محجوب = لا عضوية فعّالة (لا وثيقة users/{uid}) أو محظور/منتهٍ قسرياً.
    // دمج شرط العضوية هنا (وليس دالة exists منفصلة) لأن القواعد قرأت وثيقة
    // المستخدم أصلاً — فلا تُضاف قراءة ولا تعبيرات (سقف 1000 تعبير في القواعد
    // المركّبة). المالك يُعفى عبر isOwner() في hasPerm وبقاء وثيقته موجودة.
    function isBlockedUid(uid) {
      return !exists(userDocPath(uid))
        || ( get(userDocPath(uid)).data.get('status', '') == 'banned'
             || ( get(userDocPath(uid)).data.get('banned', false) == true
                  && !isBanExpired(uid) )
             || ( get(userDocPath(uid)).data.keys().hasAny(['forceLogoutAt'])
                  && get(userDocPath(uid)).data.get('forceLogoutAt', null) != null
                  && get(userDocPath(uid)).data.get('forceLogoutAt', 0) > 0
                  && request.auth.token.auth_time < get(userDocPath(uid)).data.get('forceLogoutAt', 0) ) );
    }

    // الجلسة الصالحة للعمل = موثّق وله عضوية فعّالة (users/{uid}) وغير محظور
    // وغير منتهٍ قسرياً. اشتراط وثيقة العضوية هو الفرض الخادمي الحقيقي لبوابة
    // التسجيل: حساب أُنشئ أثناء إيقاف التسجيل لا يملك وثيقة عضوية (رُفض إنشاؤها)
    // فلا يستطيع قراءة/كتابة أي شيء — وليس مجرد إخفاء واجهة.
    function isSignedIn() {
      return isVerified() && !isBlockedUid(request.auth.uid);
    }

    function isOwner() {
      return isVerified() &&
        request.auth.token.email in [
          'f882771f@gmail.com',
          'kal6667222@gmail.com'
        ];
    }

    // ============ نظام الصلاحيات المجهري (Micro-RBAC) ============
    // المنح تُقرأ من rbac/{uid} — القراءة من الخادم في كل عملية، فأي تلاعب
    // بكود المتصفح (إظهار زر مخفي) لا يمنح قدرة فعلية: القاعدة ترفض الكتابة.
    // الحساب المجمّد (suspended) تُسحب منه كل الصلاحيات فوراً.
    // SUPER_ADMIN_FULL_ACCESS يفتح كل الصلاحيات الأخرى.
    function rbacPath() {
      return /databases/$(database)/documents/rbac/$(request.auth.uid);
    }

    // && تعمل بقصر الدارة (short-circuit) في قواعد Firestore، فيصل get()
    // فقط عند وجود الوثيقة — ونداءات get المتكررة لنفس المسار تُحسب قراءة واحدة.
    // صلاحيات المراقبة/السجلات الحساسة (OWNER_ONLY) لا تُمنح لأي حساب غير مالك
    // حتى لو وُجد المفتاح في الوثيقة — دفاع في العمق يمنع أي تصعيد صلاحيات.
    function hasPerm(key) {
      return isOwner() || (
        isSignedIn() && exists(rbacPath()) &&
        !isOwnerOnlyPerm(key) &&
        get(rbacPath()).data.get('suspended', false) != true &&
        (get(rbacPath()).data.get('grants', {}).get(key, false) == true ||
         get(rbacPath()).data.get('grants', {}).get('SUPER_ADMIN_FULL_ACCESS', false) == true)
      );
    }

    function isOwnerOnlyPerm(key) {
      return key in [
        'MONITOR_PRIVATE_MESSAGES',
        'VIEW_SYSTEM_AUDIT_LOGS',
        'TRACK_EMPLOYEE_LIVE_SESSIONS',
        'FIREBASE_MUTATION_LOGS',
        'RECOVER_DELETED_ITEMS_ARCHIVE',
        'TRACK_FAILED_LOGINS',
        'MONITOR_USER_TRAFFIC_LIVE'
      ];
    }

    function hasUserAdminPerm() {
      return hasPerm('BAN_USER_TEMPORARY') || hasPerm('BAN_USER_PERMANENT')
          || hasPerm('UNBAN_USER_RESTORE') || hasPerm('MANAGE_USER_VERIFICATION')
          || hasPerm('FORCE_LOGOUT_SESSION') || hasPerm('SUSPEND_SUB_ADMIN_ACCOUNT');
    }

    function hasCatalogPerm() {
      return hasPerm('CREATE_NEW_CATALOG') || hasPerm('DELETE_MAIN_CATALOG')
          || hasPerm('EDIT_CATALOG_PRICING') || hasPerm('MANAGE_CATALOG_TAGS');
    }

    function hasInlineStylePerm() {
      return hasPerm('INLINE_STYLE_COLOR') || hasPerm('INLINE_FONT_CUSTOMIZE')
          || hasPerm('INLINE_BOX_SHAPE_MOD') || hasPerm('INLINE_TICKER_CONTROL')
          || hasPerm('INLINE_ELEMENT_DELETE') || hasPerm('INLINE_IMAGE_DESIGN_MOD')
          || hasPerm('INLINE_IMAGE_REPLACE');
    }

    // مرسل الرسالة: صاحب الجلسة نفسه، أو علامة 'admin' المحجوزة للمشرفين.
    // بدون هذا الشرط يستطيع أي مسجّل انتحال هوية غيره بكتابة senderId عشوائي.
    function isMessageSender() {
      return isSignedIn()
        && (request.resource.data.senderId == request.auth.uid
            || (request.resource.data.senderId == 'admin' && hasUserAdminPerm()));
    }

    // ============ هوية مشارك المحادثة (V1) ============
    // لا يكفي كون المستخدم مُسجّلاً: يجب أن يكون uid مطابقاً لأحد المشاركين
    // المسجّلين في وثيقة المحادثة (participantUids) أو مشتريها (buyerUid).
    // ملاحظة: هذه الهوية تُكتب من العميل عند إنشاء المحادثة (جلسة مجهولة)،
    // لذا فهي تمنع فضول المستخدم العادي ولا تعتمد على سرية chatId.
    function isChatParticipant(chatId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && ( request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('participantUids', [])
             || get(/databases/$(database)/documents/chats/$(chatId)).data.get('buyerUid', '') == request.auth.uid
             || get(/databases/$(database)/documents/chats/$(chatId)).data.get('sellerUid', '') == request.auth.uid );
    }

    // ============ مصفوفة الصلاحيات نفسها — محجوبة ============
    // القراءة: المالك أو صاحب الوثيقة فقط (لا يطّلع مشرف على مصفوفة غيره).
    // الكتابة: المالك فقط — أي منح ذاتي من حساب آخر مرفوض خادمياً.
    match /rbac/{uid} {
      allow read: if isOwner() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isOwner();
    }

    // ============ إعلانات حراج ============
    // V3: محتوى الإعلان (العنوان/الوصف/السعر/الحقول) لا يعدّله إلا مالكه
    // (userId == request.auth.uid) أو المالك/الفوّض. المزايدة (currentBid/bids)
    // والوساطة (escrow) ومشاهدات (views) سلوك قائم مفتوح للمسجّلين — لم يُقفل.
    match /haraj_ads/{adId} {
      function isAdOwner() {
        return isSignedIn()
          && resource.data.get('userId', '') != ''
          && resource.data.userId == request.auth.uid;
      }
      // إعلانات الحراج ومرفقات صورها محتوى عام للعرض فقط.
      // الزائر المجهول يقرأها، لكن لا يحصل على أي صلاحية تعديل أو نشر.
      allow read: if isSignedIn() || isAnonymousGuest();
      allow create: if isSignedIn() && canWriteDuringMaintenance()
                    && request.resource.data.keys().hasAll(['title', 'price'])
                    && request.resource.data.status == 'active'
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner()
                    || ( isAdOwner()
                         && request.resource.data.diff(resource.data)
                              .affectedKeys().hasOnly(['title','price','description','condition',
                                                       'location','city','size','defects','images',
                                                       'imageCount','measurements','motionFrames',
                                                       'motionDuration','isAuction','auctionEndsAt',
                                                       'updatedAt']) )
                    // المزايدة العامة وخطوات الوساطة (سلوك قائم — للمسجّلين)
                    || ( isSignedIn()
                         && request.resource.data.diff(resource.data)
                              .affectedKeys().hasOnly(['currentBid','bids','updatedAt','auctionEndsAt','escrow']) )
                    || ( isSignedIn()
                         && request.resource.data.diff(resource.data)
                              .affectedKeys().hasOnly(['views', 'updatedAt'])
                         && request.resource.data.views is number
                         && request.resource.data.views >= resource.data.views )
                    // كل صلاحية مقيّدة بالحقول التي تخصّها فقط — لا تتقاطع مع غيرها.
                    // اعتماد/رفض الإعلان: الحالة فقط (لا تعديل المحتوى أو الملكية).
                    || ( hasPerm('HARAJ_POST_APPROVE')
                         && request.resource.data.diff(resource.data)
                              .affectedKeys().hasOnly(['status','rejectionReason','rejectedAt','updatedAt'])
                         && request.resource.data.status in ['active','pending','rejected'] )
                    // استعادة إعلان محذوف/مؤرشف وإرجاعه نشطاً (بلا تغيير المحتوى).
                    || ( hasPerm('HARAJ_POST_RESTORE')
                         && request.resource.data.diff(resource.data)
                              .affectedKeys().hasOnly(['status','archivedAt','deletedAt','deletedBy',
                                                       'deletionReason','restoredAt','restoredBy','updatedAt'])
                         && request.resource.data.status == 'active' )
                    // نقل الملكية: تغيير مالك الإعلان فقط (إلى حساب محدّد).
                    || ( hasPerm('TRANSFER_POST_OWNERSHIP')
                         && request.resource.data.diff(resource.data)
                              .affectedKeys().hasOnly(['userId','transferredAt','transferredBy','updatedAt'])
                         && request.resource.data.userId is string
                         && request.resource.data.userId.size() > 0 )
                    || ( hasPerm('HARAJ_POST_FORCE_EDIT')
                         && request.resource.data.diff(resource.data)
                              .affectedKeys().hasOnly(['title','price','description','condition',
                                                       'location','city','size','defects','images',
                                                       'imageCount','measurements','updatedAt']) )
                    || ( hasPerm('HARAJ_POST_FEATURE')
                         && request.resource.data.diff(resource.data)
                              .affectedKeys().hasOnly(['featured','pinned','premium','featuredAt','updatedAt']) );
      allow delete: if isOwner() || isAdOwner() || hasPerm('HARAJ_POST_DELETE');
    }

    // الرسالة العامة داخل إعلان الحراج — للأعضاء الموثقين فقط.
    // المالك يستطيع المراجعة والحذف من غرفة صاحب الموقع.
    match /ad_public_messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && canWriteDuringMaintenance()
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.adId is string
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 500;
      allow update, delete: if isOwner()
                            || (isSignedIn()
                                && resource.data.authorUid == request.auth.uid);
    }

    // ============ مستخدمو حراج ============
    // V2: تعذّر تقييد قراءة haraj_users دون كسر «تسجيل الدخول بالهاتف»
    // (استعلام where يتطلب اجتياز قاعدة القراءة — أُثبت بالمحاكي). لذلك تبقى
    // القراءة للمسجّلين كما هي، وإغلاق V2 يتطلب ترحيلاً/دالة بحث (خارج النطاق).
    //
    // ملف حراج واحد لكل حساب: authUid إلزامي ويساوي صاحب الجلسة، ويُمنع إنشاء
    // ملف ثانٍ عبر وثيقة فهرس التفرد haraj_uid_index/{uid} (لا يمكن لقواعد
    // Firestore عدّ الاستعلامات، فالفهرس هو وسيلة الفرض الوحيدة). وauthUid/phone
    // غير قابلين للتعديل بعد الإنشاء (منع سرقة الملف أو تغيير الرقم للتحايل).
    match /haraj_users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasAll(['name', 'phone', 'authUid'])
                    && request.resource.data.authUid == request.auth.uid
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() >= 9
                    && !exists(/databases/$(database)/documents/haraj_uid_index/$(request.auth.uid));
      allow update: if isOwner() || hasUserAdminPerm()
                    || ( isSignedIn()
                         && resource.data.authUid == request.auth.uid
                         && !request.resource.data.diff(resource.data)
                              .affectedKeys().hasAny(['authUid','phone']) );
      allow delete: if isOwner() || hasUserAdminPerm();
    }

    // فهرس التفرد: وثيقة معرّفها = uid صاحب الملف. وجودها يمنع إنشاء ملف حراج
    // ثانٍ لنفس الحساب. لا يستطيع حساب إنشاء فهرس لغير uid نفسه، والحذف للمالك
    // أو من يملك صلاحية إدارة مستخدمي الحراج (لتصحيح أي حالة).
    match /haraj_uid_index/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isOwner() || hasUserAdminPerm();
    }

    // ============ البث الملكي ============
    match /broadcasts/{docId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    // ============ المستخدمون ============
    match /users/{userId} {
      // الحساب المحظور يقرأ وثيقته الشخصية فقط ليرى سبب الحظر، وكل ما عداها
      // ممنوع عليه عبر isSignedIn() (انظر isBlockedUid أعلاه).
      allow read: if isOwner()
                  || (isVerified() && request.auth.uid == userId);
      allow create: if (isAuthed() && request.auth.uid == userId
                        && (!request.resource.data.keys().hasAny(['role'])
                            || request.resource.data.role == 'user')
                        // بوابة التسجيل: عند blocked=true تُرفض عضوية أي حساب
                        // غير المالك (فلا عضوية فعّالة ولا فتح للموقع).
                        && (!registrationBlocked() || isOwnerToken()))
                    // المالك يستعيد وثيقته دائماً (مسار رخيص) — لا يُقفل نفسه.
                    || isOwner();
      // المفوَّضون (حظر/توثيق/تجميد/إنهاء جلسة) يعدّلون الحالة لكن لا يمسّون
      // الدور — تغيير role حكر على المالك وحده حتى لا يتصعّد مشرف بنفسه.
      // كل صلاحية مقيّدة بحقولها فقط: صلاحية الحظر لا تمنح التوثيق، والعكس.
      // ملاحظة أداء: نفحص نطاق الحقول (diff.hasOnly) قبل فحص الصلاحية حتى
      // تُقصّر الدارة على المسار الصحيح ولا تتجاوز تعبيرات القاعدة السقف.
      allow update: if isOwner()
                    || (request.auth.uid == userId
                        && isSignedIn()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasNone(['role', 'status', 'banned']))
                    || (request.resource.data.diff(resource.data)
                            .affectedKeys().hasOnly([
                              'status','banned','bannedAt','banReason','banType',
                              'banExpiresAt','unbannedAt','suspensionReason',
                              'updatedAt','updatedBy'
                            ])
                        && (hasPerm('BAN_USER_TEMPORARY')
                            || hasPerm('BAN_USER_PERMANENT')
                            || hasPerm('UNBAN_USER_RESTORE')))
                    || (request.resource.data.diff(resource.data)
                            .affectedKeys().hasOnly([
                              'isVerified','verified','verifiedAt','verifiedBy',
                              'updatedAt','updatedBy'
                            ])
                        && hasPerm('MANAGE_USER_VERIFICATION'))
                    // إنهاء الجلسة قسرياً: يكتب فقط حقل forceLogoutAt (لا يمسّ
                    // الدور أو الحظر) — والفرض الفعلي في isBlockedUid أعلاه.
                    || (request.resource.data.diff(resource.data)
                            .affectedKeys().hasOnly(['forceLogoutAt','updatedAt','updatedBy'])
                        && hasPerm('FORCE_LOGOUT_SESSION'));
      allow delete: if isOwner();
    }

    // ============ المنتجات والفروع (الكتالوج) ============
    match /products/{docId} {
      allow read: if true;
      allow write: if isOwner() || hasCatalogPerm();
    }

    // إعدادات عرض كل كتالوج (نمط البطاقات/إظهار الأسعار...) — قراءة عامة، وكتابة للمالك أو صاحب صلاحية الكتالوج.
    // كانت بلا قاعدة فيفشل حفظ «إعدادات العرض» في صفحة الكتالوج.
    match /catalogSettings/{docId} {
      allow read: if true;
      allow write: if isOwner() || hasCatalogPerm();
    }

    match /branches/{docId} {
      allow read: if true;
      allow write: if isOwner() || hasPerm('UPDATE_GLOBAL_SETTINGS');
    }

    // ============ الزوار ============
    match /visitors/{docId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isOwner() || hasPerm('MONITOR_USER_TRAFFIC_LIVE');
    }

    // ============ السجلات ============
    match /logs/{docId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isOwner()
                                  || hasPerm('VIEW_SYSTEM_AUDIT_LOGS')
                                  || hasPerm('FIREBASE_MUTATION_LOGS');
    }

    match /error_logs/{docId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isOwner() || hasPerm('VIEW_SYSTEM_AUDIT_LOGS');
    }

    match /security_logs/{docId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isOwner()
                                  || hasPerm('VIEW_SYSTEM_AUDIT_LOGS')
                                  || hasPerm('TRACK_FAILED_LOGINS');
    }

    // ============ سجل التدقيق الموحّد (Audit Log) ============
    // كل إجراء صلاحيات يُكتب هنا ببنية موحّدة: actor/timestamp/target/result.
    // يُنشأ من العميل بعد أن ينجح الإجراء الفعلي (والذي تفرضه القواعد الأخرى)،
    // فالكتابة عليه لا تمنح أي قدرة — والقراءة للمالك أو صاحب صلاحية السجلات.
    // السجل للإلحاق فقط (append-only) بشكل مطلق: لا تعديل ولا حذف بعد الإنشاء —
    // حتى من المالك. هذا يضمن سلامة أثر الحوادث الأمنية على الدوام.
    match /audit_logs/{docId} {
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasAll(['action', 'result']);
      allow read: if isOwner() || hasPerm('VIEW_SYSTEM_AUDIT_LOGS');
      allow update, delete: if false;
    }

    // ============ الجلسات الحيّة (تتبّع الأجهزة المتصلة) ============
    // وثيقة لكل مستخدم موثّق يحمل نبضة دورية (setDoc merge). القراءة للمالك أو
    // صاحب صلاحية تتبّع الجلسات (أو صاحب الوثيقة). لا يمنح هذا أي قدرة تنفيذية —
    // مراقبة فقط. الكتابة مقصورة على صاحب الجلسة، و uid يجب أن يطابق صاحبه
    // والدور ضمن قائمة معروفة حتى لا تُلوَّث بيانات المراقبة.
    match /sessions/{uid} {
      allow read: if isOwner()
                  || hasPerm('TRACK_EMPLOYEE_LIVE_SESSIONS')
                  || (isSignedIn() && request.auth.uid == uid);
      allow create: if isSignedIn()
                    && request.auth.uid == uid
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.role in ['owner','admin','employee','user']
                    && request.resource.data.keys().hasOnly([
                         'uid','role','userAgent','lastSeenAt','ip'
                       ]);
      allow update: if isSignedIn()
                    && request.auth.uid == uid
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.role in ['owner','admin','employee','user']
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['lastSeenAt','userAgent','role','ip']);
      allow delete: if isOwner() || (isSignedIn() && request.auth.uid == uid);
    }

    // ============ الإشعارات ============
    match /notifications/{docId} {
      allow read: if isOwner();
      allow create: if isSignedIn();
      allow update, delete: if isOwner();
    }

    // ============ الرسائل والدردشة — مراقبة الرسائل بصلاحية مجهرة ============
    match /messages/{docId} {
      allow read: if isOwner()
                  || hasPerm('MONITOR_PRIVATE_MESSAGES')
                  || (isSignedIn() && (resource.data.senderId == request.auth.uid
                                       || resource.data.receiverId == request.auth.uid));
      allow create: if isMessageSender() && canWriteDuringMaintenance();
      allow update, delete: if isOwner() || hasPerm('MONITOR_PRIVATE_MESSAGES');
    }

    match /privateMessages/{docId} {
      allow read: if isOwner()
                  || hasPerm('MONITOR_PRIVATE_MESSAGES')
                  || (isSignedIn() && (resource.data.senderId == request.auth.uid
                                       || resource.data.receiverId == request.auth.uid));
      allow create: if isMessageSender() && canWriteDuringMaintenance();
      allow update, delete: if isOwner() || hasPerm('MONITOR_PRIVATE_MESSAGES');
    }

    // محادثات خاصة بين المعلن والمشتري - V1: تقييد بالهوية الفعلية للمشاركين
    // لا يُعتمد على سرية chatId كحماية: القراءة/الكتابة للمشارك المؤكّد
    // (participantUids/buyerUid) أو المالك/المراقب فقط.
    match /chats/{chatId} {
      allow create: if isSignedIn() && canWriteDuringMaintenance();
      allow read: if isOwner()
                  || hasPerm('MONITOR_PRIVATE_MESSAGES')
                  || isChatParticipant(chatId);
      // المشارك المسجّل يمكنه تحديث الملخص (المشتري يوسّع المشاركين عند أول رسالة)
      allow update: if isOwner()
                    || hasPerm('MONITOR_PRIVATE_MESSAGES')
                    || ( isChatParticipant(chatId)
                         && request.resource.data.keys().hasOnly(
                              ['adId','adTitle','sellerKey','buyerKey','buyerName','buyerUid',
                               'sellerUid','participantUids','lastMessage','updatedAt','isPrivate','type','status'])
                         && request.resource.data.adId == resource.data.adId
                         && request.resource.data.sellerUid == resource.data.sellerUid
                         && request.resource.data.buyerUid == resource.data.buyerUid
                         && request.resource.data.participantUids == resource.data.participantUids
                         && request.resource.data.sellerKey == resource.data.sellerKey
                         && request.resource.data.buyerKey == resource.data.buyerKey );
      allow delete: if isOwner() || hasPerm('MONITOR_PRIVATE_MESSAGES');

      match /messages/{msgId} {
        allow create: if isOwner()
                      || hasPerm('MONITOR_PRIVATE_MESSAGES')
                      || isChatParticipant(chatId);
        allow read: if isOwner()
                    || hasPerm('MONITOR_PRIVATE_MESSAGES')
                    || isChatParticipant(chatId);
        allow update, delete: if isOwner() || hasPerm('MONITOR_PRIVATE_MESSAGES');
      }
    }

    // ============ الطلبات ============
    match /orders/{docId} {
      allow read: if isOwner()
                  || (isSignedIn() && resource.data.userId == request.auth.uid);
      // لا تسمح بإنشاء طلب باسم مستخدم آخر أو بحذف/تغيير الطلبات من العميل.
      allow create: if isSignedIn() && canWriteDuringMaintenance()
                    && request.resource.data.keys().hasAll(['userId'])
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner();
    }

    // ============ الشكاوى ============
    match /complaints/{docId} {
      allow create: if isSignedIn() && canWriteDuringMaintenance();
      allow read, update, delete: if isOwner();
    }

    // ============ الإعلانات العامة ============
    match /advertisements/{docId} {
      allow read: if true;
      allow write: if isOwner() || hasPerm('HARAJ_POST_FORCE_EDIT');
    }

    match /ads/{docId} {
      allow read: if true;
      allow write: if isOwner() || hasPerm('HARAJ_POST_FORCE_EDIT');
    }

    // ============ الموظفون — الرواتب والملفات بصلاحيات مجهرة ============
    match /employees/{docId} {
      // ملاحظة: صلاحية VIEW_EMPLOYEE_SALARIES مؤجلة (خارج نطاق المرحلة الأولى)،
      // فلا تمنح قراءةً هنا. قراءة الموظفين متاحة للمالك أو صلاحيات الموظفين الفعلية.
      allow read: if isOwner()
                  || hasPerm('ADD_NEW_EMPLOYEE')
                  || hasPerm('EDIT_EMPLOYEE_PROFILE')
                  || hasPerm('TRACK_EMPLOYEE_LIVE_SESSIONS');
      allow write: if isOwner()
                   || hasPerm('ADD_NEW_EMPLOYEE')
                   || hasPerm('EDIT_EMPLOYEE_PROFILE');
    }

    // ============ التقارير ============
    match /reports/{docId} {
      allow create: if isSignedIn() && canWriteDuringMaintenance();
      allow read, update, delete: if isOwner() || hasPerm('VIEW_SYSTEM_AUDIT_LOGS');
    }

    // ============ جلسات الزوار ============
    match /guestSessions/{docId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isOwner();
    }

    // ============ لوحة المالك ============
    match /admin/{docId} {
      allow read: if isOwner();
      allow write: if isOwner();
    }

    // ============ البانرات والتصنيفات والكوبونات ============
    match /banners/{docId} {
      allow read: if isSignedIn();
      allow write: if isOwner() || hasPerm('MANAGE_NAVIGATION_MENU');
    }

    match /categories/{docId} {
      allow read: if isSignedIn();
      allow write: if isOwner() || hasCatalogPerm();
    }

    match /coupons/{docId} {
      allow read, write: if isOwner();
    }

    // ============ السلة والمفضلة ============
    match /cart/{userId}/{item=**} {
      allow read, write: if isOwner()
                         || (isSignedIn() && request.auth.uid == userId);
    }

    match /favorites/{userId}/{item=**} {
      allow read, write: if isOwner()
                         || (isSignedIn() && request.auth.uid == userId);
    }

    // ============ التقييمات ============
    match /reviews/{docId} {
      allow read: if true;
      allow create: if isSignedIn() && canWriteDuringMaintenance();
      allow update, delete: if isOwner();
    }

    // ============ إعدادات المتجر — مفصّلة حسب الوثيقة والصلاحية ============
    match /settings/{docId} {
      allow read: if true;
      allow write: if isOwner()
                   || (docId == 'siteTexts' && hasPerm('INLINE_TEXT_EDIT'))
                   || (docId == 'inlineStyles' && hasInlineStylePerm())
                   || (docId == 'maintenance' && hasPerm('TOGGLE_MAINTENANCE_MODE'))
                   || (docId == 'registrationGate' && hasPerm('BLOCK_USER_REGISTRATION'))
                   || (docId == 'cacheBuster' && hasPerm('FLUSH_SYSTEM_CACHE'))
                   || (docId == 'navigation' && hasPerm('MANAGE_NAVIGATION_MENU'))
                   || (docId == 'snippets' && hasPerm('CODE_SNIPPET_INJECTION'))
                   || hasPerm('UPDATE_GLOBAL_SETTINGS');
    }

    // ============ تعليقات الرئيسية وحراج ============
    match /comments/{docId} {
      allow read: if true;

      // إنشاء التعليق للزوار/المستخدمين كما كان، لكن بحقول محددة وحالة إلزامية
      // 'pending'. بدون ذلك يستطيع أي زائر كتابة status:'approved' فيُنشر
      // تعليقه فوراً متجاوزاً مراجعة المالك.
      allow create: if canWriteDuringMaintenance()
                    && request.resource.data.keys().hasAll(['text'])
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 250
                    && request.resource.data.keys().hasOnly([
                         'text','name','email','city','status','likes','createdAt'
                       ])
                    && request.resource.data.status == 'pending';

      // التعديل:
      // - المالك يستطيع تعديل كل شيء.
      // - صاحب HARAJ_COMMENT_EDIT يستطيع تعديل التعليق أو تغيير حالته
      //   (اعتماد/رفض) — وهو ما يفعله CommentsReviewPanel فعلاً. منعه هنا
      //   كان يُبقي كل تعليق معلّقاً في «قيد المراجعة» بلا إمكانية اعتماد.
      //   لا يُسمح له بمسح نص التعليق أو حقوله.
      // - تحديث likes يتطلب عضواً موثقاً، ويقبل زيادة واحدة فقط.
      allow update: if isOwner()
                    || (
                      hasPerm('HARAJ_COMMENT_EDIT')
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['status'])
                      && request.resource.data.status in ['approved','rejected','pending']
                    )
                    || ( isSignedIn()
                         && request.resource.data.diff(resource.data)
                              .affectedKeys().hasOnly(['likes'])
                         && request.resource.data.likes is number
                         && request.resource.data.likes == resource.data.likes + 1 );

      // الحذف: المالك أو صاحب صلاحية حذف التعليقات (يطابق زر «رفض» في اللوحة).
      allow delete: if isOwner() || hasPerm('HARAJ_COMMENT_DELETE');
    }

    // ============ طلبات الفستان (wanted_dresses) — عام + خاص ============
    // الوثيقة العامة تحمل ownerUid (معرّف مبهم) فقط لربط الملكية، بلا هاتف/بريد.
    // البيانات الشخصية في وثيقة فرعية محصورة private/{uid}. لا تُترك بيانات يتيمة:
    // لا يُسمح بحذف الوثيقة العامة ما دامت وثيقتها الخاصة موجودة (يجب حذف الخاصة أولاً).
    match /wanted_dresses/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && canWriteDuringMaintenance()
                    && request.resource.data.keys().hasAll(['title','status','ownerUid'])
                    && request.resource.data.keys().hasOnly([
                         'title','color','budget','eventDate','bust','waist','hip',
                         'length','notes','status','userName','ownerUid','createdAt'
                       ])
                    && request.resource.data.ownerUid == request.auth.uid;
      // تعديل: المالك/المخوّل فقط.
      allow update: if isOwner() || hasPerm('HARAJ_POST_FORCE_EDIT');
      // حذف: صاحب الطلب/المالك/المخوّل، وبشرط ألا تبقى وثيقة خاصة (منع البيانات اليتيمة).
      allow delete: if isSignedIn()
                    && (isOwner() || hasPerm('HARAJ_POST_FORCE_EDIT')
                        || resource.data.ownerUid == request.auth.uid)
                    && !exists(/databases/$(database)/documents/wanted_dresses/$(docId)/private/$(resource.data.ownerUid));

      // البيانات الشخصية: تسجيل دخول إلزامي + ملكية الطلب + جوال سعودي صالح.
      match /private/{privateId} {
        allow read: if isSignedIn()
                    && (privateId == request.auth.uid
                        || isOwner() || hasPerm('HARAJ_POST_FORCE_EDIT'));
        allow create: if isSignedIn() && canWriteDuringMaintenance()
                      && privateId == request.auth.uid
                      && get(/databases/$(database)/documents/wanted_dresses/$(docId)).data.ownerUid == request.auth.uid
                      && request.resource.data.keys().hasAll(['userPhone'])
                      && request.resource.data.keys().hasOnly(['userPhone','userEmail','createdAt'])
                      && request.resource.data.userPhone is string
                      && request.resource.data.userPhone.matches('^05[0-9]{8}$');
        // التحديث يبقي الجوال صالحاً ويمنع حذفه/إفراغه؛ صاحب الطلب يحقّله مع تعديل بريده فقط.
        allow update: if isSignedIn()
                      && request.resource.data.keys().hasAll(['userPhone'])
                      && request.resource.data.userPhone is string
                      && request.resource.data.userPhone.matches('^05[0-9]{8}$')
                      && (
                           (privateId == request.auth.uid
                            && request.resource.data.diff(resource.data)
                                 .affectedKeys().hasOnly(['userPhone','userEmail']))
                           || isOwner() || hasPerm('HARAJ_POST_FORCE_EDIT')
                         );
        // حذف البيانات الخاصة: المالك/المخوّل أو صاحب الطلب نفسه (لتمكين الحذف المتسلسل).
        allow delete: if isSignedIn()
                      && (isOwner() || hasPerm('HARAJ_POST_FORCE_EDIT')
                          || privateId == request.auth.uid);
      }
    }

    // ============ مشتركو نشرة العروض ============
    match /subscribers/{emailId} {
      allow create: if request.resource.data.keys().hasOnly(['email'])
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
      allow read, update, delete: if isOwner();
    }

    // ============ أرشيف المحذوفات السري ============
    // كل حذف حقيقي يُلحق نسخة كاملة من الوثيقة هنا قبل/بعد الحذف ليتمكن
    // المالك من الاستعادة. البنية إلزامية حتى لا يُستخدم الأرشيف مخزناً عشوائياً.
    match /deleted_archive/{docId} {
      allow create: if (isOwner()
                        || hasPerm('RECOVER_DELETED_ITEMS_ARCHIVE')
                        || hasPerm('HARAJ_POST_DELETE'))
                    && request.resource.data.keys().hasAll(
                         ['sourceCollection','sourceId','payload','deletedAt'])
                    && request.resource.data.sourceCollection is string
                    && request.resource.data.sourceId is string
                    && request.resource.data.payload is map;
      allow read, update, delete: if isOwner() || hasPerm('RECOVER_DELETED_ITEMS_ARCHIVE');
    }

    // ============ أي وثيقة أخرى — قراءة للمالك فقط (وضع آمن) ============
    // الكتابة لا تُمنح عشوائياً هنا: أي مجموعة بلا قاعدة صريحة تبقى مغلقة،
    // وحتى المالك لا يمرّ عبر هذا المطاط لتعديل/حذف سجلات append-only
    // (audit_logs) — فلا ثغرة تعديل سجل من المالك.
    match /{document=**} {
      allow read: if isOwner();
    }
  }
}
