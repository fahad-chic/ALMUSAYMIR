# =====================================================================
# المسيمير | ALMUSAYMIR — متغيرات البيئة
# انسخ هذا الملف إلى .env ثم املأ القيم المطلوبة.
# لا ترفع ملف .env إلى Git نهائياً.
#
# قاعدة مهمة: أي متغير يبدأ بـ VITE_ يُخبز داخل حزمة الواجهة وقت البناء
# (Vite). المتغيرات بلا VITE_ تُقرأ في دوال Cloudflare وقت التشغيل فقط،
# ولا تصل للواجهة إطلاقاً. الأسرار الحقيقية تُضبط في
# Cloudflare Pages → Settings → Environment variables (Secrets).
# =====================================================================


# ---------------------------------------------------------------------
# Firebase (وقت البناء — لازمة لتشغيل الواجهة)
# ---------------------------------------------------------------------
# يقرأها: src/firebase/config.js
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# اختياري — للتحليلات فقط
VITE_FIREBASE_MEASUREMENT_ID=


# ---------------------------------------------------------------------
# المالك والمشرف (وقت البناء)
# ---------------------------------------------------------------------
# يقرأها: src/App.jsx · AuthContext · useStore · firebase/index.js
# تنبيه: firestore.rules لا تقرأ المتغيرات — إيميلات المالك مكتوبة داخل
# القواعد. تغييرها هنا وحده لا يغيّر صلاحيات Firestore (يجب تعديل القواعد
# ونشرها أيضاً).
VITE_OWNER_EMAILS=
VITE_ADMIN_EMAILS=

# الرمز السري لبوابة المالك المخفية (3 نقرات في صفحة الدخول).
# يبدأ بـ VITE_ فيظهر داخل حزمة المتصفح لأي زائر — لا تعتبره سراً حقيقياً.
# الحماية الفعلية: /api/owner-pin على الخادم + إيميل المالك + قفل المحاولات.
VITE_OWNER_SECRET_CODE=


# ---------------------------------------------------------------------
# التواصل (وقت البناء)
# ---------------------------------------------------------------------
VITE_PHONE_1=
VITE_PHONE_2=
# نسخ العرض (تظهر للزائر بصيغة 0096…)
VITE_PHONE_1_DISPLAY=
VITE_PHONE_2_DISPLAY=
VITE_CONTACT_WHATSAPP_1=
VITE_CONTACT_WHATSAPP_2=
VITE_CONTACT_EMAIL=
VITE_SNAPCHAT_URL=
VITE_SNAPCHAT_USERNAME=


# ---------------------------------------------------------------------
# الحسابات البنكية (وقت البناء)
# ---------------------------------------------------------------------
VITE_BANK_RAJHI_NAME=
VITE_BANK_RAJHI_IBAN=
VITE_BANK_RAJHI_ACCOUNT=

VITE_BANK_ARABI_NAME=
VITE_BANK_ARABI_IBAN=
VITE_BANK_ARABI_ACCOUNT=


# ---------------------------------------------------------------------
# بيانات المتجر (وقت البناء)
# ---------------------------------------------------------------------
VITE_STORE_NAME=
VITE_STORE_DESCRIPTION=
# رسوم الشحن والحد الأدنى للشحن المجاني وسياسة الإرجاع
VITE_SHIPPING_FEE=20
VITE_FREE_SHIPPING_MIN=500
VITE_RETURN_POLICY_DAYS=7


# ---------------------------------------------------------------------
# المساعد الذكي — الواجهة (وقت البناء)
# ---------------------------------------------------------------------
# يقرأها: src/components/AIChat.jsx
VITE_AI_NAME=فهد


# ---------------------------------------------------------------------
# صوت دخول المالك (وقت البناء)
# ---------------------------------------------------------------------
# يقرأها: src/App.jsx
VITE_OWNER_SOUND_URL=/sounds/welcome.mp3
VITE_SOUND_DURATION_SECONDS=10


# ---------------------------------------------------------------------
# أسرار الخادم (Cloudflare Pages Functions — وقت التشغيل)
# ---------------------------------------------------------------------
# تُضبط كـ Secrets في لوحة Cloudflare، وليست متغيرات بناء.
# لا تضع لها بادئة VITE_ إطلاقاً.

# مفتاح Groq — بدونه لا يجيب المساعد (functions/api/ai.js).
GROQ_API_KEY=

# مفتاح Resend — بدونه لا يُرسل كود التحقق (functions/api/otp/send.js).
RESEND_API_KEY=

# المرسل في رسائل OTP.
# تنبيه: onboarding@resend.dev يرسل فقط إلى بريد حساب Resend نفسه.
# لأكواد الزوار يجب توثيق نطاق ووضع بريد منه، مثل: no-reply@yourdomain.com
OTP_FROM_EMAIL=onboarding@resend.dev

# مفتاح ويب Firebase للدوال (اختياري — يسقط على VITE_FIREBASE_API_KEY).
# تستخدمه owner-pin و broadcast للتحقق من توكن Firebase.
FIREBASE_WEB_API_KEY=


# ---------------------------------------------------------------------
# ربط قاعدة D1 (Binding — ليس متغيراً نصياً)
# ---------------------------------------------------------------------
# يُضبط من: Cloudflare Pages → Settings → Functions → D1 database bindings
#   Variable name: DB
#   Database:      chic_users
# موجود أيضاً في wrangler.toml تحت env.production و env.preview.
# بدونه تتعطل: OTP · بوابة المالك · البث · الذكاء الاصطناعي.
